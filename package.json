{
  "name": "trevui-monorepo",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "^22.18.0 || >=23.6.0"
  },
  "scripts": {
    "test": "pnpm --dir packages/eslint-plugin run build && vitest run",
    "lint": "pnpm --dir packages/eslint-plugin run build && eslint --max-warnings 0 . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit && vue-tsc -p registry/tsconfig.json --noEmit",
    "dev:vite": "pnpm --filter playground-vite dev",
    "dev:nuxt": "pnpm --filter playground-nuxt dev",
    "registry:build": "node scripts/registry-build.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@iconify/vue": "5.0.5",
    "@types/node": "22.20.5",
    "ajv": "8.20.0",
    "clsx": "2.1.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.12.1",
    "prettier": "3.10.0",
    "tailwind-merge": "3.7.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0",
    "vue": "3.5.45",
    "vue-eslint-parser": "10.4.2",
    "vue-tsc": "3.3.14"
  }
}
