{
  "permissions": {
    "allow": [
      "Bash(pnpm install --frozen-lockfile:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm install --frozen-lockfile && pnpm test:install:*)",
      "Bash(pnpm lint:*)"
    ]
  },
  "extraKnownMarketplaces": {
    "sdlc": {
      "source": {
        "source": "github",
        "repo": "tammai/sdlc"
      }
    }
  },
  "enabledPlugins": {
    "sdlc@sdlc": true,
    "sdlc-extras@sdlc": true,
    "sdlc-stepper@sdlc": true
  }
}
