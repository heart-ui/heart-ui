{
  "name": "@heart-ui/theme",
  "version": "0.0.0",
  "private": true,
  "description": "Theme knobs to CSS: OKLCH scales, semantic tokens, contrast checks and the Tailwind mapping.",
  "license": "MIT",
  "homepage": "https://heart.tammai.me",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heart-ui/heart-ui.git",
    "directory": "packages/theme"
  },
  "bugs": "https://github.com/heart-ui/heart-ui/issues",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./theme.css": "./css/theme.css",
    "./tokens.css": "./css/tokens.css"
  },
  "files": [
    "dist",
    "css"
  ],
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "test": "vitest run",
    "generate": "tsdown && node scripts/generate.mjs"
  },
  "peerDependencies": {
    "tailwindcss": ">=4.0.0"
  },
  "devDependencies": {
    "@types/culori": "4.0.1",
    "tailwindcss": "4.3.5",
    "tsdown": "0.23.7",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "culori": "4.0.2"
  }
}
