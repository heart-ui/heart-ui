{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "paths": {
      "@/lib/*": ["./registry/lib/*"],
      "@/components/ui/*": ["./registry/ui/*"]
    }
  },
  "include": [
    "tests/**/*.ts",
    "vitest.config.ts",
    "packages/theme/src/**/*.ts",
    "packages/theme/test/**/*.ts",
    "packages/eslint-plugin/src/**/*.ts",
    "packages/eslint-plugin/test/**/*.ts",
    "packages/cli/src/**/*.ts",
    "packages/cli/test/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": ["packages/cli/test/fixtures/**"]
}
