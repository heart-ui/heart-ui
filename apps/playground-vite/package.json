{
  "name": "playground-vite",
  "version": "0.0.0",
  "private": true,
  "description": "Vite playground; hosts browser and visual tests.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -p tsconfig.json && vue-tsc -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "test:browser": "vitest run --config vitest.config.ts",
    "test:visual": "node visual/run.ts"
  },
  "dependencies": {
    "@trevui/theme": "workspace:*",
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/browser-playwright": "5.1.0",
    "axe-core": "4.14.0",
    "playwright": "1.65.0",
    "tailwindcss": "4.3.5",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
