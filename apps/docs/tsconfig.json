{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node", "vite/client"],
    "allowImportingTsExtensions": true,
    "paths": {
      "@/lib/*": ["../../registry/lib/*"],
      "@/components/ui/*": ["../../registry/ui/*"]
    }
  },
  "include": [
    ".vitepress/**/*.ts",
    ".vitepress/**/*.vue",
    "scripts/**/*.ts",
    "test/**/*.ts",
    "../demo-files.ts"
  ]
}
