{
  "name": "select",
  "version": "0.1.0",
  "components": [
    {
      "name": "Select",
      "props": [
        {
          "name": "disabled",
          "type": "boolean",
          "required": false,
          "default": "false"
        },
        {
          "name": "name",
          "type": "string",
          "required": false,
          "description": "Submits the chosen item's value in its form; `required` needs it."
        },
        {
          "name": "required",
          "type": "boolean",
          "required": false,
          "default": "false"
        },
        {
          "name": "modelValue",
          "type": "string",
          "required": false
        },
        {
          "name": "open",
          "type": "boolean",
          "required": false
        }
      ],
      "slots": [
        {
          "name": "default"
        }
      ],
      "events": [
        {
          "name": "update:modelValue",
          "payload": "string | undefined"
        },
        {
          "name": "update:open",
          "payload": "boolean | undefined"
        }
      ]
    },
    {
      "name": "SelectContent",
      "props": [],
      "slots": [
        {
          "name": "default"
        }
      ],
      "events": []
    },
    {
      "name": "SelectGroup",
      "props": [],
      "slots": [
        {
          "name": "default"
        }
      ],
      "events": []
    },
    {
      "name": "SelectItem",
      "props": [
        {
          "name": "value",
          "type": "string",
          "required": true
        },
        {
          "name": "disabled",
          "type": "boolean",
          "required": false,
          "default": "false"
        }
      ],
      "slots": [
        {
          "name": "default"
        }
      ],
      "events": []
    },
    {
      "name": "SelectLabel",
      "props": [],
      "slots": [
        {
          "name": "default"
        }
      ],
      "events": []
    },
    {
      "name": "SelectSeparator",
      "props": [],
      "slots": [],
      "events": []
    },
    {
      "name": "SelectTrigger",
      "props": [
        {
          "name": "size",
          "type": "'md' | 'sm' | 'lg'",
          "required": false,
          "default": "'md'"
        },
        {
          "name": "invalid",
          "type": "boolean",
          "required": false,
          "default": "false"
        },
        {
          "name": "placeholder",
          "type": "string",
          "required": false,
          "description": "Shown while nothing is chosen."
        }
      ],
      "slots": [],
      "events": []
    }
  ]
}
