{
  "name": "button",
  "version": "0.1.0",
  "components": [
    {
      "name": "Button",
      "props": [
        {
          "name": "variant",
          "type": "'primary' | 'danger' | 'secondary' | 'outline' | 'ghost' | 'link'",
          "required": false,
          "default": "'secondary'"
        },
        {
          "name": "size",
          "type": "'md' | 'sm' | 'lg'",
          "required": false,
          "default": "'md'"
        },
        {
          "name": "disabled",
          "type": "boolean",
          "required": false,
          "default": "false"
        },
        {
          "name": "loading",
          "type": "boolean",
          "required": false,
          "default": "false"
        },
        {
          "name": "type",
          "type": "'button' | 'submit' | 'reset'",
          "required": false,
          "default": "'button'",
          "description": "Ignored when the rendered element is not a `button`."
        },
        {
          "name": "asChild",
          "type": "boolean",
          "required": false,
          "default": "false",
          "description": "Change the default rendered element for the one passed as a child, merging their props and behavior.\n\nRead our [Composition](https://www.reka-ui.com/docs/guides/composition) guide for more details."
        },
        {
          "name": "as",
          "type": "AsTag | Component",
          "required": false,
          "default": "'button'",
          "description": "The element or component this component should render as. Can be overwritten by `asChild`."
        }
      ],
      "slots": [
        {
          "name": "default"
        },
        {
          "name": "leading"
        },
        {
          "name": "trailing"
        }
      ],
      "events": []
    }
  ]
}
