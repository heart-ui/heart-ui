{
  "name": "radio-group",
  "version": "0.1.0",
  "components": [
    {
      "name": "RadioGroup",
      "props": [
        {
          "name": "size",
          "type": "'md' | 'sm' | 'lg'",
          "required": false,
          "default": "'md'"
        },
        {
          "name": "orientation",
          "type": "'vertical' | 'horizontal'",
          "required": false,
          "default": "'vertical'",
          "description": "Layout; arrow keys move through the group in both directions either way."
        },
        {
          "name": "disabled",
          "type": "boolean",
          "required": false,
          "default": "false"
        },
        {
          "name": "name",
          "type": "string",
          "required": false,
          "description": "Submits the chosen item's value in its form; `required` needs it."
        },
        {
          "name": "required",
          "type": "boolean",
          "required": false,
          "default": "false"
        },
        {
          "name": "modelValue",
          "type": "string",
          "required": false
        }
      ],
      "slots": [
        {
          "name": "default"
        }
      ],
      "events": [
        {
          "name": "update:modelValue",
          "payload": "string | undefined"
        }
      ]
    },
    {
      "name": "RadioGroupItem",
      "props": [
        {
          "name": "value",
          "type": "string",
          "required": true
        },
        {
          "name": "disabled",
          "type": "boolean",
          "required": false,
          "default": "false"
        }
      ],
      "slots": [
        {
          "name": "default"
        }
      ],
      "events": []
    }
  ]
}
